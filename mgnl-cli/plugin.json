{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox-plugin.schema.json",
  "name": "mgnl-cli",
  "version": "0.1.0",
  "description": "Local development helper for lightweight Magnolia development @ TRIMM",
  "packages": [
    "fnm@1.38.1",
    "temurin-bin-25@25.0.0",
    "yq-go@4.53.2"
  ],
  "create_files": {
    "{{ .Virtenv }}/mgnl.config.js": "mgnl/mgnl.config.js",
    "{{ .Virtenv }}/package.json": "mgnl/package.json",
    "{{ .Virtenv }}/project-templates.json": "mgnl/project-templates.json",
    "{{ .Virtenv }}/package-lock.json": "mgnl/package-lock.json",
    "{{ .Virtenv }}/vault-auth.sh": "mgnl/vault-auth.sh"
  },
  "env": {
    "VAULT_ADDR": "https://vault.platform.trimm.net"
  },
  "shell": {
    "init_hook": [
      "eval \"$(fnm env --use-on-cd)\"",
      "alias mgnlup='devbox run mgnlup'"
    ],
    "scripts": {
      "mgnlup": "cd {{ .Virtenv }} && exec npx @magnolia/cli@latest start -lmp ${DEVBOX_PROJECT_ROOT}/modules",
      "setup:magnolia": [
        "chmod +x {{ .Virtenv }}/vault-auth.sh",
        "{{ .Virtenv }}/vault-auth.sh",
        "export NPM_TOKEN=$(bao kv get -field=token platform/common/local/technology-npm-registry)",
        "EDITION=$(kubectl kustomize ${DEVBOX_PROJECT_ROOT}/manifests/magnolia | yq eval 'select(.apiVersion == \"magnolia.platform.trimm.net/v1alpha1\" and .kind == \"Environment\") | .spec.magnoliaVersion' - | cut -d: -f1) && [ -n \"$EDITION\" ] || { echo 'Failed to detect Magnolia edition from manifests' >&2; exit 1; }; echo \"Detected Magnolia edition: $EDITION\"",
        "# Strip lightModulesPath so @magnolia/cli-jumpstart-plugin always re-adds it; otherwise its addConfigProps spinner never resolves and the run hangs forever.",
        "sed -i.bak '/^[[:space:]]*lightModulesPath:/d' {{ .Virtenv }}/mgnl.config.js && rm -f {{ .Virtenv }}/mgnl.config.js.bak",
        "(cd {{ .Virtenv }} && npx @magnolia/cli@latest jumpstart --template \"platform/nuxt/$EDITION\" --project-templates \"./project-templates.json\")",
        "(cd {{ .Virtenv }} && npx @magnolia/cli@latest cli-tp-runner-plugin -m ${DEVBOX_PROJECT_ROOT}/manifests/magnolia -p ${DEVBOX_PROJECT_ROOT})"
      ],
      "start:magnolia": [
        "mgnlup"
      ]
    }
  }
}
